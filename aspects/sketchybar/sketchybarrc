#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

sketchybar --remove '/.*/'

# Stay inside macOS's menu-bar area (32 points on the notched laptop).
sketchybar --bar \
  height=24 \
  notch_display_height=32 \
  position=top \
  topmost=off \
  show_in_fullscreen=off \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  color="$CAT_BAR" \
  shadow=off \
  blur_radius=20

sketchybar --default \
  icon.font="SF Pro:Bold:13.0" \
  icon.color="$CAT_TEXT" \
  icon.padding_left=10 \
  icon.padding_right=4 \
  label.font="SF Pro:Semibold:13.0" \
  label.color="$CAT_TEXT" \
  label.padding_left=4 \
  label.padding_right=10 \
  background.color="$CAT_ACCENT_DIM" \
  background.corner_radius=8 \
  background.height=22 \
  padding_left=4 \
  padding_right=4

sketchybar --add item apps left \
  --set apps icon="󰀻" \
    width=32 \
    icon.width=32 \
    icon.align=center \
    icon.color="$CAT_MAUVE" \
    icon.padding_left=0 \
    icon.padding_right=0 \
    label.drawing=off \
    background.drawing=on \
    click_script="$PLUGIN_DIR/app_drawer.sh toggle"

sketchybar --add item apps.ghostty left \
  --set apps.ghostty icon="󰊠" \
    icon.color="$CAT_GREEN" \
    icon.font="JetBrainsMono Nerd Font:Regular:16.0" \
    click_script="/usr/bin/open -a Ghostty; $PLUGIN_DIR/app_drawer.sh close"

sketchybar --add item apps.brave left \
  --set apps.brave icon="" \
    icon.color="$CAT_PEACH" \
    icon.font="Font Awesome 7 Brands:Regular:16.0" \
    click_script="/usr/bin/open -a 'Brave Browser'; $PLUGIN_DIR/app_drawer.sh close"

sketchybar --add item apps.obsidian left \
  --set apps.obsidian icon="󰹕" \
    icon.color="$CAT_MAUVE" \
    icon.font="JetBrainsMono Nerd Font:Regular:16.0" \
    click_script="/usr/bin/open -a Obsidian; $PLUGIN_DIR/app_drawer.sh close"

sketchybar --add item apps.spotify left \
  --set apps.spotify icon="" \
    icon.color="$CAT_GREEN" \
    icon.font="JetBrainsMono Nerd Font:Regular:16.0" \
    click_script="/usr/bin/open -a Spotify; $PLUGIN_DIR/app_drawer.sh close"

for item in apps.ghostty apps.brave apps.obsidian apps.spotify; do
  sketchybar --set "$item" \
    drawing=off \
    width=0 \
    icon.padding_left=0 \
    icon.padding_right=0 \
    label.drawing=off \
    background.drawing=on \
    background.color="$CAT_TRANSPARENT" \
    script="$PLUGIN_DIR/hover.sh" \
  --subscribe "$item" mouse.entered mouse.exited
done

# Keep the drawer toggle visually separated from the first workspace pill.
sketchybar --add item apps_spacer left \
  --set apps_spacer width=8 \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off

sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5 6 7 8 9 S; do
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" icon="$sid" \
      icon.width=24 \
      icon.padding_left=8 \
      icon.padding_right=8 \
      label.font="JetBrainsMono Nerd Font:Regular:14.0" \
      label.padding_left=2 \
      label.padding_right=6 \
      label.drawing=off \
      background.drawing=on \
      background.border_width=0 \
      update_freq=0 \
      script="$PLUGIN_DIR/workspace.sh" \
      click_script="aerospace workspace $sid; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$sid" \
    --subscribe "space.$sid" aerospace_workspace_change system_woke front_app_switched
done

sketchybar --add item clock right \
  --set clock icon.drawing=off \
    label.padding_left=10 \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh" \
    click_script="open -a Calendar"

sketchybar --add item battery right \
  --set battery icon.font="JetBrainsMono Nerd Font:Regular:16.0" \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

sketchybar --add item wifi right \
  --set wifi icon.font="JetBrainsMono Nerd Font:Regular:16.0" \
    icon.padding_right=10 \
    label.drawing=off \
    update_freq=60 \
    script="$PLUGIN_DIR/wifi.sh" \
    click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'" \
  --subscribe wifi wifi_change system_woke

sketchybar --update
