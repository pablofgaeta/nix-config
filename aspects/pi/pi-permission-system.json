{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.pi/agent/auth.json": "deny"
    },
    "external_directory_write": {
      "*": "ask"
    },
    "mcp": {
      "*": "ask"
    },
    "bash": {
      "*": "allow",
      "*curl * --data*": "ask",
      "*curl * -X DELETE*": "ask",
      "*curl * -X PATCH*": "ask",
      "*curl * -X POST*": "ask",
      "*curl * -X PUT*": "ask",
      "*curl * -d *": "ask",
      "*gh api*": "ask",
      "*gh gist create*": "ask",
      "*gh issue close*": "ask",
      "*gh issue comment*": "ask",
      "*gh issue create*": "ask",
      "*gh issue edit*": "ask",
      "*gh pr close*": "ask",
      "*gh pr comment*": "ask",
      "*gh pr create*": "ask",
      "*gh pr edit*": "ask",
      "*gh pr merge*": "deny",
      "*gh pr review*": "ask",
      "*gh release *": "ask",
      "*gh repo delete*": "deny",
      "*gh secret set*": "ask",
      "*gh workflow run*": "ask",
      "*git commit*": "ask",
      "*git push*": "ask",
      "*jj git push*": "ask",
      "sudo *": "ask",
      "doas *": "ask",
      "rm -rf *": "ask",
      "*git reset --hard*": "ask",
      "*git clean*": "ask",
      "*jj abandon*": "ask",
      "*jj restore*": "ask"
    }
  }
}
